# TMDb v3 API key, or the v4 "API Read Access Token" (long JWT)
TMDB_API_KEY=

# Path to the Firebase service account JSON file, or the raw JSON string
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Comma separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# Seconds to cache TMDb responses
CACHE_TTL_SECONDS=300

# Sign-in and storage: auto (default), firebase or local.
# auto uses Firebase when FIREBASE_SERVICE_ACCOUNT is raw JSON or an existing file, otherwise local mode.
# Local mode needs no Firebase: accounts, reviews and lists are stored in LOCAL_DB_PATH (SQLite).
AUTH_MODE=auto
LOCAL_DB_PATH=./movie_magic.db
# Optional secret for signing local login tokens. Empty = generated once and stored in the DB.
AUTH_SECRET=
